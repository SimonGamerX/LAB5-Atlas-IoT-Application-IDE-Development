{
  "name": "CircadianComfortGuard",
  "version": "1.0",
  "author": "iotpj Group",
  "description": "Circadian Ergonomic Stress & Photothermal Microclimate Guardian. Cross-couples ambient illuminance (ADS1115 LDR) and dial temperature (KY-040) to dynamically adjust cooling and trigger smart alerts.",
  "loop": true,
  "loop_interval_sec": 4.0,
  "steps": [
    {
      "step_index": 1,
      "type": "Type1",
      "description": "Read current ambient illuminance via ADC CH0",
      "service": "Read_Light_Level",
      "inputs": "()"
    },
    {
      "step_index": 2,
      "type": "Type1",
      "description": "Read thermostat dial temperature setpoint via Rotary Encoder",
      "service": "Read_Temperature",
      "inputs": "()"
    },
    {
      "step_index": 3,
      "type": "Type3",
      "description": "Dynamic Cooling: If dial temperature > 27 C, activate Green Cooling/Fan LED",
      "service_a": "Read_Temperature",
      "operator": ">",
      "threshold": 27,
      "service_b": "Set_Cooling_Indicator",
      "inputs_b": "(1)",
      "else_service": "Set_Cooling_Indicator",
      "else_inputs": "(0)"
    },
    {
      "step_index": 4,
      "type": "Type5",
      "description": "Hazard Guard: If pitch black (<15% Light) AND High Temp (>32 C), trigger Red Alarm LED",
      "logic_op": "AND",
      "condition1": {
        "service": "Read_Light_Level",
        "operator": "<",
        "threshold": 15
      },
      "condition2": {
        "service": "Read_Temperature",
        "operator": ">",
        "threshold": 32
      },
      "action_service": "Set_Alarm_LED",
      "action_inputs": "(1)"
    },
    {
      "step_index": 5,
      "type": "Type2",
      "description": "Order-based Safety Confirmation: Ensure Cooling Indicator successfully engaged after temp check",
      "service_a": "Read_Temperature",
      "service_b": "Set_Cooling_Indicator",
      "inputs_b": "(1)"
    }
  ]
}

