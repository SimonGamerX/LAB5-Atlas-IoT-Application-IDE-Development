{
  "name": "CircadianComfortGuard",
  "version": "1.0",
  "author": "iotpj Group",
  "description": "Adaptive Photothermal Microclimate & Hazard Guardian. Uses light sensing (ADS1115 LDR) and dial temperature (KY-040) to dynamically trigger cooling and safety alerts.",
  "loop": true,
  "loop_interval_sec": 3.0,
  "steps": [
    {
      "step_index": 1,
      "type": "Type1",
      "description": "Read ambient light level from ADS1115 ADC CH0",
      "service": "Read_Light_Level",
      "inputs": "()"
    },
    {
      "step_index": 2,
      "type": "Type1",
      "description": "Read simulated temperature dial from Rotary Encoder",
      "service": "Read_Temperature",
      "inputs": "()"
    },
    {
      "step_index": 3,
      "type": "Type3",
      "description": "Dynamic Cooling: If dial temperature > 27 C, activate Green Cooling LED",
      "service_a": "Read_Temperature",
      "operator": ">",
      "threshold": 27,
      "service_b": "Set_Cooling_Indicator",
      "inputs_b": "(1)",
      "else_service": "Set_Cooling_Indicator",
      "else_inputs": "(0)"
    },
    {
      "step_index": 4,
      "type": "Type3",
      "description": "Nocturnal Alert: If ambient light < 20%, trigger Red Alarm LED",
      "service_a": "Read_Light_Level",
      "operator": "<",
      "threshold": 20,
      "service_b": "Set_Alarm_LED",
      "inputs_b": "(1)"
    },
    {
      "step_index": 5,
      "type": "Type2",
      "description": "Order-based Safety Check: Ensure Cooling runs after temperature check completes",
      "service_a": "Read_Temperature",
      "service_b": "Set_Cooling_Indicator",
      "inputs_b": "(1)"
    }
  ]
}
