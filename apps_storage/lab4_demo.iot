{
  "name": "Lab4DemoApp",
  "version": "1.0",
  "author": "iotpj Group",
  "description": "Baseline automated demo from Lab 4 Part II: sequential light read, temperature read, alarm LED test, and cooling indicator test.",
  "loop": false,
  "loop_interval_sec": 2.0,
  "steps": [
    {
      "step_index": 1,
      "type": "Type1",
      "description": "Read ambient light level from ADS1115 ADC CH0",
      "service": "Read_Light_Level",
      "inputs": "()"
    },
    {
      "step_index": 2,
      "type": "Type1",
      "description": "Read temperature from Rotary Encoder dial",
      "service": "Read_Temperature",
      "inputs": "()"
    },
    {
      "step_index": 3,
      "type": "Type1",
      "description": "Activate Red Alarm LED on GPIO 16 (state=1)",
      "service": "Set_Alarm_LED",
      "inputs": "(1)"
    },
    {
      "step_index": 4,
      "type": "Type1",
      "description": "Deactivate Red Alarm LED on GPIO 16 (state=0)",
      "service": "Set_Alarm_LED",
      "inputs": "(0)"
    },
    {
      "step_index": 5,
      "type": "Type1",
      "description": "Activate Green Cooling LED on GPIO 12 (state=1)",
      "service": "Set_Cooling_Indicator",
      "inputs": "(1)"
    },
    {
      "step_index": 6,
      "type": "Type1",
      "description": "Deactivate Green Cooling LED on GPIO 12 (state=0)",
      "service": "Set_Cooling_Indicator",
      "inputs": "(0)"
    }
  ]
}

